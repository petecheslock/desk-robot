# Copy to .env (git-ignored) and fill in. Loaded by brain/config.py on start.

# Key for the language model behind Rocky. Which provider it belongs to is
# LLM_BASE_URL in brain/config.py: OpenRouter by default (openrouter.ai/keys),
# or an Anthropic or OpenAI key with that provider's URL and model name.
LLM_API_KEY=
# Optional: Anthropic or OpenAI directly instead of OpenRouter, e.g.
#   LLM_BASE_URL=https://api.anthropic.com/v1/   and   LLM_MODEL=claude-haiku-5-5
# Leave both empty for OpenRouter with Claude Haiku 5.5.
LLM_BASE_URL=
LLM_MODEL=

# Optional: your own speech server — Rocky's voice. Anything that speaks the
# OpenAI audio API (POST /v1/audio/speech, GET /v1/models) on your LAN or tailnet — this project
# has been run against gufo (github.com/gufo-org/gufo) serving Qwen3-TTS on a Strix Halo box.
# No key: nothing is sent with the request. The model id and the sample rate it answers at are
# read from the server on first use, so only these two are needed. TTS_SERVER_VOICE names one of
# its voices — a required name, because a server's default voice is often a cloning one that
# wants a reference recording in every request. GET /v1/audio/voices on the server lists them.
# Without a server, the built-in fallback voice speaks (espeak-ng on Linux).
TTS_SERVER_URL=
TTS_SERVER_VOICE=

# Optional: focus mode, where Rocky keeps you off your phone during a focus session
# ("Rocky, help me focus for 25 minutes"). He checks the camera picture with OpenAI's
# Decisions API, about 3 cents a 25-minute session. platform.openai.com/api-keys
# (needs billing set up). Separate from LLM_API_KEY above.
OPENAI_API_KEY=

# What Rocky calls you
HUMAN_NAME=

# Shared secret the robot must present when it connects (also in firmware/include/secrets.h)
ROBOT_TOKEN=

# Shared secret the dashboard/live view asks for (the human side; the robot never uses it). The brain
# serves its console on all interfaces inside the container, so this token is the gate: open the page
# as http://localhost:8766/?token=<this>. At least 16 random characters, e.g.
# python3 -c "import secrets; print(secrets.token_hex(16))". May stay empty only when the console is
# bound to loopback (LIVE_VIEW_BIND=127.0.0.1 in brain/config.py) for local development.
CONSOLE_TOKEN=

# Optional: a Host header the console answers to (a DNS-rebinding belt; the token is the real gate).
# Leave empty to accept any Host.
PUBLIC_HOST=

# Local development only: bind the brain's console to this computer (127.0.0.1), so it serves without
# CONSOLE_TOKEN. The fork's default (empty) binds all interfaces for the container, where the token is
# required. The launcher's dashboard on :8766 always binds loopback.
LIVE_VIEW_BIND=

# Optional: where the two turn-detection models are cached on first run.
# Default is ~/.cache/desk-robot/ (the speech model goes to ~/.cache/huggingface/).
DESK_ROBOT_CACHE=
